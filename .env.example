# Safe local defaults. Copy to .env for local workspace use.
COMPOSE_PROJECT_NAME=company-check
COMPANY_CHECK_SERVICE_PORT=8080
COMPANY_CHECK_PROVIDER_PORT=3000
COMPANY_CHECK_DB_HOST=localhost
COMPANY_CHECK_DB_PORT=5432
COMPANY_CHECK_DB_NAME=company_check
COMPANY_CHECK_DB_USER=company_check
COMPANY_CHECK_DB_PASSWORD=change-me-locally
COMPANY_CHECK_SERVICE_IMAGE=company-check-service@sha256:replace-with-approved-digest
COMPANY_CHECK_PROVIDER_IMAGE=company-check-provider@sha256:replace-with-approved-digest
POSTGRES_IMAGE=postgres:16@sha256:replace-with-approved-digest
REDIS_IMAGE=redis:7@sha256:replace-with-approved-digest
PROMETHEUS_IMAGE=prom/prometheus:v3@sha256:replace-with-approved-digest
MIMIR_IMAGE=grafana/mimir:latest@sha256:replace-with-approved-digest
LOKI_IMAGE=grafana/loki:latest@sha256:replace-with-approved-digest
TEMPO_IMAGE=grafana/tempo:latest@sha256:replace-with-approved-digest
GRAFANA_IMAGE=grafana/grafana:latest@sha256:replace-with-approved-digest
GRAFANA_ADMIN_PASSWORD=change-me-locally
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=24h
PROMETHEUS_RETENTION_SIZE=512MB
COMPOSE_WAIT_TIMEOUT_SECONDS=120
