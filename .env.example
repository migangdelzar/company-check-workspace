# Safe local defaults. Copy to .env for local workspace use.
# Local tags are convenient for development. The performance runner resolves
# local images to immutable digests before starting its Compose stack.
COMPOSE_PROJECT_NAME=company-check
COMPANY_CHECK_SERVICE_PORT=8080
COMPANY_CHECK_PROVIDER_PORT=3000
COMPANY_CHECK_DB_HOST=localhost
COMPANY_CHECK_DB_PORT=5432
COMPANY_CHECK_DB_NAME=company_check
COMPANY_CHECK_DB_USER=company_check
COMPANY_CHECK_DB_PASSWORD=change-me-locally
SPRING_PROFILES_ACTIVE=single-node
JAVA_TOOL_OPTIONS=
OTEL_SERVICE_NAME=company-check-service
OTEL_METRICS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
COMPANY_CHECK_SERVICE_IMAGE=company-check-service:local
COMPANY_CHECK_PROVIDER_IMAGE=company-check-provider:local
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
COMPOSE_WAIT_TIMEOUT_SECONDS=120
LOCUST_IMAGE=locustio/locust:2.32.10
PROMETHEUS_IMAGE=prom/prometheus:v3.8.0
GRAFANA_IMAGE=grafana/grafana:12.1.1
TEMPO_IMAGE=grafana/tempo:2.8.2
LOKI_IMAGE=grafana/loki:3.7.0
ALLOY_IMAGE=grafana/alloy:v1.11.2
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=24h
PERFORMANCE_ARTIFACTS_DIR=.performance-artifacts
COMPANY_CHECK_DEBUG_PORT=8081
COMPANY_CHECK_JDWP_PORT=5005
COMPANY_CHECK_JDWP_TARGET_PORT=5005
